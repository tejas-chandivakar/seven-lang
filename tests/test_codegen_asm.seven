!! Generate actual .asm from hand-built IR and write to file
!! Then we assemble + link + run outside to verify it works

!! ============================================================
!! CODEGEN (inline)
!! ============================================================
asm_lines = []
asm_data  = []
asm_bss   = []
asm_str_count = [0]
cg_label = [0]
asm_var_names = []

func emit(line)
    push(asm_lines, line)
end

func emit_data(line)
    push(asm_data, line)
end

func emit_bss(line)
    push(asm_bss, line)
end

func cg_has_var(name)
    i = 0
    while i < len(asm_var_names)
        if asm_var_names[i] == name
            return 1
        end
        i = i + 1
    end
    return 0
end

func ensure_var(name)
    if cg_has_var(name) == 0
        push(asm_var_names, name)
        emit_bss("    _v_" + name + " resq 1")
    end
end

func add_string(s)
    idx = asm_str_count[0]
    asm_str_count[0] = asm_str_count[0] + 1
    label = "_s" + str(idx)
    slen = len(s)
    emit_data("    " + label + " db " + chr(34) + s + chr(34) + ", 0")
    emit_data("    " + label + "_len equ " + str(slen))
    return label
end

func emit_header()
    emit("; Generated by SEVEN Self-Hosted Compiler")
    emit("")
    emit("extern rt_init, rt_alloc, rt_exit")
    emit("extern rt_print_str, rt_print_int, rt_print_newline")
    emit("extern rt_print_val")
    emit("extern rt_str_to_int, rt_str_len, rt_str_concat")
    emit("extern rt_int_to_str, rt_str_eq, rt_str_copy")
    emit("extern rt_div_check")
    emit("extern rt_arr_new, rt_arr_push, rt_arr_get, rt_arr_set, rt_arr_len")
    emit("extern rt_len, rt_type")
    emit("extern rt_ord, rt_chr, rt_substr, rt_str_char_at")
    emit("extern rt_abs, rt_min, rt_max, rt_sqrt, rt_pow, rt_random")
    emit("extern rt_range, rt_assert")
    emit("extern rt_subscript")
    emit("extern rt_str_upper, rt_str_lower, rt_str_trim")
    emit("extern rt_str_contains, rt_str_replace")
    emit("extern rt_str_startswith, rt_str_endswith")
    emit("extern rt_str_index, rt_str_split")
    emit("extern rt_arr_slice, rt_arr_reverse, rt_arr_sort, rt_arr_join")
    emit("extern rt_file_read_str, rt_file_write_str")
    emit("extern rt_file_exists")
    emit("extern rt_time, rt_clock, rt_sleep")
    emit("extern rt_prompt, rt_read_line")
    emit("extern saved_rsp")
    emit("")
    emit("section .text")
    emit("    global _start")
    emit("")
    emit("_start:")
    emit("    mov [saved_rsp], rsp")
    emit("    call rt_init")
end

func emit_footer()
    emit("")
    emit("    ; exit(0)")
    emit("    mov rax, 60")
    emit("    xor rdi, rdi")
    emit("    syscall")
end

func codegen_inst(inst)
    op = map_get(inst, "op")
    if op == "CONST"
        val = map_get(inst, "value")
        vtype = type(val)
        if vtype == "string"
            slabel = add_string(val)
            emit("    mov rax, " + slabel)
            emit("    push rax")
        else
            emit("    mov rax, " + str(val))
            emit("    push rax")
        end
        return 0
    end
    if op == "LOAD"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    mov rax, [_v_" + name + "]")
        emit("    push rax")
        return 0
    end
    if op == "STORE"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    pop rax")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end
    if op == "BINOP"
        bop = map_get(inst, "binop")
        emit("    pop rbx")
        emit("    pop rax")
        if bop == "+"
            lnum = cg_label[0]
            cg_label[0] = cg_label[0] + 1
            emit("    cmp rax, 0x400000")
            emit("    jb _add_int_" + str(lnum))
            emit("    cmp rbx, 0x400000")
            emit("    jb _add_int_" + str(lnum))
            emit("    mov rdi, rax")
            emit("    mov rsi, rbx")
            emit("    call rt_str_concat")
            emit("    jmp _add_done_" + str(lnum))
            emit("_add_int_" + str(lnum) + ":")
            emit("    add rax, rbx")
            emit("_add_done_" + str(lnum) + ":")
        elif bop == "-"
            emit("    sub rax, rbx")
        elif bop == "*"
            emit("    imul rax, rbx")
        elif bop == "<"
            emit("    cmp rax, rbx")
            emit("    setl al")
            emit("    movzx rax, al")
        elif bop == "=="
            emit("    cmp rax, rbx")
            emit("    sete al")
            emit("    movzx rax, al")
        end
        emit("    push rax")
        return 0
    end
    if op == "SHOW"
        emit("    pop rdi")
        emit("    call rt_print_val")
        emit("    call rt_print_newline")
        return 0
    end
    if op == "LABEL"
        name = map_get(inst, "name")
        emit(name + ":")
        return 0
    end
    if op == "JMP"
        label = map_get(inst, "label")
        emit("    jmp " + label)
        return 0
    end
    if op == "JZ"
        label = map_get(inst, "label")
        emit("    pop rax")
        emit("    test rax, rax")
        emit("    jz " + label)
        return 0
    end
    if op == "FUNC"
        fname = map_get(inst, "name")
        emit("")
        emit("_f_" + fname + ":")
        emit("    push rbp")
        emit("    mov rbp, rsp")
        return 0
    end
    if op == "PARAM"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    pop rax")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end
    if op == "ENDFUNC"
        emit("    xor rax, rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end
    if op == "RET"
        emit("    pop rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end
    if op == "ARG"
        return 0
    end
    if op == "CALL"
        fname = map_get(inst, "name")
        nargs = map_get(inst, "nargs")
        if fname == "len"
            emit("    pop rdi")
            emit("    call rt_len")
            emit("    push rax")
        elif fname == "str"
            emit("    pop rdi")
            emit("    call rt_int_to_str")
            emit("    push rax")
        else
            emit("    call _f_" + fname)
            emit("    push rax")
        end
        return 0
    end
    if op == "NOP"
        return 0
    end
    return 0
end

func codegen_generate(ir)
    emit_header()
    i = 0
    while i < len(ir)
        codegen_inst(ir[i])
        i = i + 1
    end
    emit_footer()
    emit("")
    emit("section .data")
    emit("    _nl db 10")
    j = 0
    while j < len(asm_data)
        push(asm_lines, asm_data[j])
        j = j + 1
    end
    emit("")
    emit("section .bss")
    emit("    __err resq 1")
    j = 0
    while j < len(asm_bss)
        push(asm_lines, asm_bss[j])
        j = j + 1
    end
end

!! ============================================================
!! Helper: build IR instructions
!! ============================================================
func mk_ir(op)
    n = map_new()
    n = map_set(n, "op", op)
    return n
end

!! ============================================================
!! Build IR for: x = 40 + 2  show x  show "Hello"
!! ============================================================
ir = []

!! x = 40 + 2
n = mk_ir("CONST")
n = map_set(n, "value", 40)
push(ir, n)
n = mk_ir("CONST")
n = map_set(n, "value", 2)
push(ir, n)
n = mk_ir("BINOP")
n = map_set(n, "binop", "+")
push(ir, n)
n = mk_ir("STORE")
n = map_set(n, "name", "x")
push(ir, n)

!! show x
n = mk_ir("LOAD")
n = map_set(n, "name", "x")
push(ir, n)
push(ir, mk_ir("SHOW"))

!! show "Hello"
n = mk_ir("CONST")
n = map_set(n, "value", "Hello")
push(ir, n)
push(ir, mk_ir("SHOW"))

!! Generate assembly
codegen_generate(ir)

!! Write to file
output = ""
i = 0
while i < len(asm_lines)
    output = output + asm_lines[i] + chr(10)
    i = i + 1
end
write "build/selfhost_test.asm", output

nlines = len(asm_lines)
show "Generated {nlines} lines of assembly"
show "Wrote build/selfhost_test.asm"
show "all_done"
