if age atleast 18
    show "Adult"
or if age atleast 13
    show "Teenager"
else
    show "Child"
end

day = "Monday"
if day is "Saturday"
    show "Weekend"
or if day is "Monday"
    show "Work day!"
else
    show "Other day"
end

if age above 10
    show "Above ten"
end
if age below 20
    show "Below twenty"
end
if age isnt 20
    show "Not twenty"
end

!! --- 17. And / Or / Not ---
