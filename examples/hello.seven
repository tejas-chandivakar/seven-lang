show "Hello, SEVEN!"
show "Fast as Assembly. Simple as Python."

!! String interpolation
name = ask "Your name: "
age = ask "Your age: "

show "Hello, {name}!"
show "Your age: {age}"

!! Multi-arg show
show "Name:", name, "Age:", age
