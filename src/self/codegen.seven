!! ============================================================
!! SEVEN Self-Hosted Code Generator
!! Translates IR instructions -> x86-64 NASM assembly
!!
!! Stack-based: values live on the x86 stack.
!! Each IR "register" result is pushed; consumed by pop.
!! Uses rt_* runtime functions from runtime.asm.
!!
!! SEVEN scoping rules apply:
!!   - All global resets MUST happen at top level
!!   - push(arr, val) modifies global arrays from functions
!!   - map_set returns new map, so maps can't be modified
!!     from functions — use arrays + push instead
!! ============================================================

asm_lines = []
asm_data  = []
asm_bss   = []
asm_str_count = [0]
cg_label = [0]
asm_var_names = []

func emit(line)
    push(asm_lines, line)
end

func emit_data(line)
    push(asm_data, line)
end

func emit_bss(line)
    push(asm_bss, line)
end

func cg_has_var(name)
    i = 0
    while i < len(asm_var_names)
        if asm_var_names[i] == name
            return 1
        end
        i = i + 1
    end
    return 0
end

func ensure_var(name)
    if cg_has_var(name) == 0
        push(asm_var_names, name)
        emit_bss("    _v_" + name + " resq 1")
    end
end

func add_string(s)
    idx = asm_str_count[0]
    asm_str_count[0] = asm_str_count[0] + 1
    label = "_s" + str(idx)
    slen = len(s)
    emit_data("    " + label + " db " + chr(34) + s + chr(34) + ", 0")
    emit_data("    " + label + "_len equ " + str(slen))
    return label
end

func emit_header()
    emit("; Generated by SEVEN Self-Hosted Compiler")
    emit("; x86-64 NASM (Linux ELF64)")
    emit("")
    emit("extern rt_init, rt_alloc, rt_exit")
    emit("extern rt_print_str, rt_print_int, rt_print_newline")
    emit("extern rt_print_val")
    emit("extern rt_str_to_int, rt_str_len, rt_str_concat")
    emit("extern rt_int_to_str, rt_str_eq, rt_str_copy")
    emit("extern rt_div_check")
    emit("extern rt_arr_new, rt_arr_push, rt_arr_get, rt_arr_set, rt_arr_len")
    emit("extern rt_len, rt_type")
    emit("extern rt_ord, rt_chr, rt_substr, rt_str_char_at")
    emit("extern rt_abs, rt_min, rt_max, rt_sqrt, rt_pow, rt_random")
    emit("extern rt_range, rt_assert")
    emit("extern rt_subscript")
    emit("extern rt_str_upper, rt_str_lower, rt_str_trim")
    emit("extern rt_str_contains, rt_str_replace")
    emit("extern rt_str_startswith, rt_str_endswith")
    emit("extern rt_str_index, rt_str_split")
    emit("extern rt_arr_slice, rt_arr_reverse, rt_arr_sort, rt_arr_join")
    emit("extern rt_file_read_str, rt_file_write_str")
    emit("extern rt_file_exists")
    emit("extern rt_time, rt_clock, rt_sleep")
    emit("extern rt_prompt, rt_read_line")
    emit("extern saved_rsp")
    emit("")
    emit("section .text")
    emit("    global _start")
    emit("")
    emit("_start:")
    emit("    mov [saved_rsp], rsp")
    emit("    call rt_init")
end

func emit_footer()
    emit("")
    emit("    ; exit(0)")
    emit("    mov rax, 60")
    emit("    xor rdi, rdi")
    emit("    syscall")
end

!! ============================================================
!! Translate one IR instruction to NASM
!! ============================================================
func codegen_inst(inst)
    op = map_get(inst, "op")

    if op == "CONST"
        val = map_get(inst, "value")
        vtype = type(val)
        if vtype == "string"
            slabel = add_string(val)
            emit("    mov rax, " + slabel)
            emit("    push rax")
        else
            emit("    mov rax, " + str(val))
            emit("    push rax")
        end
        return 0
    end

    if op == "LOAD"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    mov rax, [_v_" + name + "]")
        emit("    push rax")
        return 0
    end

    if op == "STORE"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    pop rax")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end

    if op == "BINOP"
        bop = map_get(inst, "binop")
        emit("    pop rbx")
        emit("    pop rax")

        if bop == "+"
            lnum = cg_label[0]
            cg_label[0] = cg_label[0] + 1
            emit("    cmp rax, 0x400000")
            emit("    jb _add_int_" + str(lnum))
            emit("    cmp rbx, 0x400000")
            emit("    jb _add_int_" + str(lnum))
            emit("    mov rdi, rax")
            emit("    mov rsi, rbx")
            emit("    call rt_str_concat")
            emit("    jmp _add_done_" + str(lnum))
            emit("_add_int_" + str(lnum) + ":")
            emit("    add rax, rbx")
            emit("_add_done_" + str(lnum) + ":")
        elif bop == "-"
            emit("    sub rax, rbx")
        elif bop == "*"
            emit("    imul rax, rbx")
        elif bop == "/"
            emit("    mov rdi, rbx")
            emit("    call rt_div_check")
            emit("    cqo")
            emit("    idiv rbx")
        elif bop == "%"
            emit("    mov rdi, rbx")
            emit("    call rt_div_check")
            emit("    cqo")
            emit("    idiv rbx")
            emit("    mov rax, rdx")
        elif bop == "=="
            emit("    cmp rax, rbx")
            emit("    sete al")
            emit("    movzx rax, al")
        elif bop == "!="
            emit("    cmp rax, rbx")
            emit("    setne al")
            emit("    movzx rax, al")
        elif bop == "<"
            emit("    cmp rax, rbx")
            emit("    setl al")
            emit("    movzx rax, al")
        elif bop == ">"
            emit("    cmp rax, rbx")
            emit("    setg al")
            emit("    movzx rax, al")
        elif bop == "<="
            emit("    cmp rax, rbx")
            emit("    setle al")
            emit("    movzx rax, al")
        elif bop == ">="
            emit("    cmp rax, rbx")
            emit("    setge al")
            emit("    movzx rax, al")
        elif bop == "and"
            emit("    test rax, rax")
            emit("    setnz al")
            emit("    test rbx, rbx")
            emit("    setnz bl")
            emit("    and al, bl")
            emit("    movzx rax, al")
        elif bop == "or"
            emit("    or rax, rbx")
            emit("    test rax, rax")
            emit("    setnz al")
            emit("    movzx rax, al")
        end

        emit("    push rax")
        return 0
    end

    if op == "UNARY"
        uop = map_get(inst, "unop")
        emit("    pop rax")
        if uop == "-"
            emit("    neg rax")
        elif uop == "not"
            emit("    test rax, rax")
            emit("    setz al")
            emit("    movzx rax, al")
        end
        emit("    push rax")
        return 0
    end

    if op == "SHOW"
        emit("    pop rdi")
        emit("    call rt_print_val")
        emit("    call rt_print_newline")
        return 0
    end

    if op == "ASK"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    call rt_read_line")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end

    if op == "LABEL"
        name = map_get(inst, "name")
        emit(name + ":")
        return 0
    end

    if op == "JMP"
        label = map_get(inst, "label")
        emit("    jmp " + label)
        return 0
    end

    if op == "JZ"
        label = map_get(inst, "label")
        emit("    pop rax")
        emit("    test rax, rax")
        emit("    jz " + label)
        return 0
    end

    if op == "JNZ"
        label = map_get(inst, "label")
        emit("    pop rax")
        emit("    test rax, rax")
        emit("    jnz " + label)
        return 0
    end

    if op == "ARG"
        return 0
    end

    if op == "CALL"
        fname = map_get(inst, "name")
        nargs = map_get(inst, "nargs")
        if fname == "len"
            emit("    pop rdi")
            emit("    call rt_len")
            emit("    push rax")
        elif fname == "str"
            emit("    pop rdi")
            emit("    call rt_int_to_str")
            emit("    push rax")
        elif fname == "int"
            emit("    pop rdi")
            emit("    call rt_str_to_int")
            emit("    push rax")
        elif fname == "type"
            emit("    pop rdi")
            emit("    call rt_type")
            emit("    push rax")
        elif fname == "ord"
            emit("    pop rdi")
            emit("    call rt_ord")
            emit("    push rax")
        elif fname == "chr"
            emit("    pop rdi")
            emit("    call rt_chr")
            emit("    push rax")
        elif fname == "char_at"
            emit("    pop rsi")
            emit("    pop rdi")
            emit("    call rt_str_char_at")
            emit("    push rax")
        elif fname == "substr"
            emit("    pop rdx")
            emit("    pop rsi")
            emit("    pop rdi")
            emit("    call rt_substr")
            emit("    push rax")
        elif fname == "abs"
            emit("    pop rdi")
            emit("    call rt_abs")
            emit("    push rax")
        elif fname == "min"
            emit("    pop rsi")
            emit("    pop rdi")
            emit("    call rt_min")
            emit("    push rax")
        elif fname == "max"
            emit("    pop rsi")
            emit("    pop rdi")
            emit("    call rt_max")
            emit("    push rax")
        elif fname == "sqrt"
            emit("    pop rdi")
            emit("    call rt_sqrt")
            emit("    push rax")
        elif fname == "pow"
            emit("    pop rsi")
            emit("    pop rdi")
            emit("    call rt_pow")
            emit("    push rax")
        elif fname == "random"
            emit("    call rt_random")
            emit("    push rax")
        elif fname == "error"
            emit("    pop rdi")
            emit("    call rt_exit")
        elif fname == "exit"
            emit("    pop rdi")
            emit("    mov rax, 60")
            emit("    syscall")
        elif fname == "map_new"
            emit("    xor rdi, rdi")
            emit("    call rt_alloc")
            emit("    push rax")
        else
            emit("    call _f_" + fname)
            emit("    push rax")
        end
        return 0
    end

    if op == "RET"
        emit("    pop rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end

    if op == "RET0"
        emit("    xor rax, rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end

    if op == "FUNC"
        fname = map_get(inst, "name")
        emit("")
        emit("_f_" + fname + ":")
        emit("    push rbp")
        emit("    mov rbp, rsp")
        return 0
    end

    if op == "PARAM"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    pop rax")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end

    if op == "ENDFUNC"
        emit("    xor rax, rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end

    if op == "ASSERT"
        emit("    pop rdi")
        emit("    call rt_assert")
        return 0
    end

    if op == "INDEX"
        emit("    pop rsi")
        emit("    pop rdi")
        emit("    call rt_subscript")
        emit("    push rax")
        return 0
    end

    if op == "ISTORE"
        emit("    pop rdx")
        emit("    pop rsi")
        emit("    pop rdi")
        emit("    call rt_arr_set")
        return 0
    end

    if op == "ARRLIT"
        count = map_get(inst, "count")
        emit("    mov rdi, " + str(count))
        emit("    call rt_arr_new")
        if count > 0
            emit("    mov rcx, " + str(count))
            emit("    mov r12, rax")
            emit("._arr_fill_" + str(cg_label[0]) + ":")
            emit("    push rcx")
            emit("    push r12")
            emit("    pop rdi")
            emit("    pop rcx")
            emit("    dec rcx")
            emit("    push rcx")
            emit("    mov rdi, r12")
            emit("    pop rsi")
            emit("    push r12")
            emit("    call rt_arr_push")
            emit("    pop r12")
            emit("    pop rcx")
            emit("    test rcx, rcx")
            emit("    jnz ._arr_fill_" + str(cg_label[0]))
            cg_label[0] = cg_label[0] + 1
            emit("    push r12")
        else
            emit("    push rax")
        end
        return 0
    end

    if op == "PUSH"
        emit("    pop rsi")
        emit("    pop rdi")
        emit("    call rt_arr_push")
        return 0
    end

    if op == "NOP"
        return 0
    end

    return 0
end

!! ============================================================
!! Generate assembly: walk IR and emit all sections
!! MUST reset globals at top level before calling this!
!! ============================================================
func codegen_generate(ir)
    emit_header()

    i = 0
    while i < len(ir)
        codegen_inst(ir[i])
        i = i + 1
    end

    emit_footer()

    emit("")
    emit("section .data")
    emit("    _nl db 10")
    j = 0
    while j < len(asm_data)
        push(asm_lines, asm_data[j])
        j = j + 1
    end

    emit("")
    emit("section .bss")
    emit("    __err resq 1")
    j = 0
    while j < len(asm_bss)
        push(asm_lines, asm_bss[j])
        j = j + 1
    end
end

!! ============================================================
!! Print assembly output
!! ============================================================
func codegen_print()
    i = 0
    while i < len(asm_lines)
        show asm_lines[i]
        i = i + 1
    end
end
