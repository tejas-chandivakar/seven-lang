!! Assert-based math tests

!! Basic arithmetic
x = 5 + 3
assert(x == 8, "5 + 3 should be 8")

x = 10 - 4
assert(x == 6, "10 - 4 should be 6")

x = 3 * 7
assert(x == 21, "3 * 7 should be 21")

x = 20 / 4
assert(x == 5, "20 / 4 should be 5")

x = 17 % 5
assert(x == 2, "17 % 5 should be 2")

!! Negative numbers
x = 0 - 5
assert(x == -5, "0 - 5 should be -5")

x = -3 * 2
assert(x == -6, "-3 * 2 should be -6")

!! Order of operations
x = 2 + 3 * 4
assert(x == 14, "2 + 3 * 4 should be 14")

x = (2 + 3) * 4
assert(x == 20, "(2 + 3) * 4 should be 20")

!! Math builtins
x = abs(-7)
assert(x == 7, "abs(-7) should be 7")

x = abs(7)
assert(x == 7, "abs(7) should be 7")

x = min(3, 9)
assert(x == 3, "min(3,9) should be 3")

x = max(3, 9)
assert(x == 9, "max(3,9) should be 9")

x = clamp(15, 0, 10)
assert(x == 10, "clamp(15,0,10) should be 10")

x = clamp(-5, 0, 10)
assert(x == 0, "clamp(-5,0,10) should be 0")

x = clamp(5, 0, 10)
assert(x == 5, "clamp(5,0,10) should be 5")

x = sign(42)
assert(x == 1, "sign(42) should be 1")

x = sign(-42)
assert(x == -1, "sign(-42) should be -1")

x = sign(0)
assert(x == 0, "sign(0) should be 0")

x = gcd(12, 8)
assert(x == 4, "gcd(12,8) should be 4")

x = pow(2, 10)
assert(x == 1024, "pow(2,10) should be 1024")

!! Bitwise ops
x = 5 & 3
assert(x == 1, "5 & 3 should be 1")

x = 5 | 3
assert(x == 7, "5 | 3 should be 7")

x = 5 ^ 3
assert(x == 6, "5 ^ 3 should be 6")

show "All math assertions passed!"
