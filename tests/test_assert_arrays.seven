!! Assert-based array tests

!! Create and access
a = [10, 20, 30]
assert(a[0] == 10, "first element should be 10")
assert(a[1] == 20, "second element should be 20")
assert(a[2] == 30, "third element should be 30")

!! Length
assert(len(a) == 3, "array length should be 3")

!! Push
push(a, 40)
assert(len(a) == 4, "length after push should be 4")
assert(a[3] == 40, "pushed element should be 40")

!! Sort
nums = [5, 2, 8, 1, 3]
sorted = sort(nums)
assert(sorted[0] == 1, "sorted first should be 1")
assert(sorted[4] == 8, "sorted last should be 8")

!! Reverse
r = [1, 2, 3]
rev = reverse(r)
assert(rev[0] == 3, "reversed first should be 3")
assert(rev[2] == 1, "reversed last should be 1")

!! Join
words = ["hello", "world"]
s = join(words, " ")
assert(s == "hello world", "join with space")

!! Unique
dupes = [1, 2, 2, 3, 3, 1]
u = unique(dupes)
assert(len(u) == 3, "unique length should be 3")

!! Fill
f = fill(3, 0)
assert(len(f) == 3, "fill length should be 3")
assert(f[0] == 0, "fill value should be 0")

!! Concat
x = [1, 2]
y = [3, 4]
z = concat(x, y)
assert(len(z) == 4, "concat length should be 4")
assert(z[2] == 3, "concat element 2 should be 3")

!! Insert
data = [1, 2, 4]
data = insert(data, 2, 3)
assert(data[2] == 3, "inserted element should be 3")
assert(len(data) == 4, "length after insert should be 4")

!! Remove
rem = [10, 20, 30, 40]
removed = remove(rem, 1)
assert(removed == 20, "removed element should be 20")
assert(len(rem) == 3, "length after remove should be 3")

show "All array assertions passed!"
