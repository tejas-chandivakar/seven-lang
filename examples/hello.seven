show "Hello, SEVEN!"
show "Fast as Assembly. Simple as Python."

!! Auto-interpolation
name = ask "Naam: "
age = ask "Umar: "

show "Namaste, {name}!"
show "Tamari umar: {age}"

!! Multi-arg show (auto space)
show "Naam:", name, "Umar:", age
