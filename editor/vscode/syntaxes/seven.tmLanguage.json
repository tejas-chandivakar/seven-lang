{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SEVEN",
  "scopeName": "source.seven",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-io" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-operators-word" },
    { "include": "#builtins" },
    { "include": "#methods" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-bang.seven",
          "match": "!!.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.seven",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.seven",
              "match": "\\\\[nrt\\\\\"0]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.seven",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.seven",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.seven",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.seven",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.seven",
          "match": "\\b(if|elif|or if|else|end|while|repeat|each|in|match|case|try|catch|error|return|break|continue|stop)\\b"
        }
      ]
    },
    "keywords-io": {
      "patterns": [
        {
          "name": "keyword.other.io.seven",
          "match": "\\b(show|ask|err|write|read|secret)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "patterns": [
        {
          "name": "keyword.other.declaration.seven",
          "match": "\\b(func|many|set)\\b"
        }
      ]
    },
    "keywords-operators-word": {
      "patterns": [
        {
          "name": "keyword.operator.word.seven",
          "match": "\\b(and|or|not|is|isnt|equals|above|below|atleast|atmost)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.seven",
          "match": "\\b(len|push|pop|slice|reverse|step|abs|min|max|sqrt|random|type|sort|join|range)\\s*\\("
        }
      ]
    },
    "methods": {
      "patterns": [
        {
          "name": "support.function.method.seven",
          "match": "\\.(upper|lower|trim|contains|equals|replace|len|startswith|endswith|index|split|repeat)\\s*\\("
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.seven",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.seven",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.seven",
          "match": "\\+|-|\\*\\*|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.seven",
          "match": "="
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.seven" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.seven",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
