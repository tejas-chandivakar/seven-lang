show "before lex"
tok_types = []
tok_vals = []
lex_run("x = 42")
show "after lex"
n = len(tok_types)
show n
i = 0
while i < n
    t = tok_types[i]
    v = tok_vals[i]
    show "{t}: {v}"
    i = i + 1
end
show "done"
