use "src/self/lexer.seven"
use "src/self/parser.seven"
use "src/self/analyzer.seven"
use "src/self/irgen.seven"
use "src/self/codegen.seven"

show "=== SEVEN Self-Hosted Compiler ==="

source = "show 42" + chr(10)

tok_types = []
tok_vals = []
tok_lines = []
lex_run(source)
ntoks = len(tok_types)
show ntoks

p_types = tok_types
p_vals = tok_vals
p_lines = tok_lines
p_pos[0] = 0
p_len[0] = ntoks
pa_result = []
stmts = parse_all()
show len(stmts)

errors = []
sym_globals = map_new()
ana_scope[0] = 0
ana_in_loop[0] = 0
ana_register_funcs(stmts)
ana_block(stmts)
show len(errors)

ir_code = []
ir_reg[0] = 0
ir_label[0] = 0
ir_block(stmts)
show len(ir_code)

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir_code)
show len(asm_lines)
show "=== DONE ==="
