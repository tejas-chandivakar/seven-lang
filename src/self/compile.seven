use "src/self/lexer.seven"
use "src/self/parser.seven"
use "src/self/analyzer.seven"
use "src/self/irgen.seven"
use "src/self/codegen.seven"

show "=== SEVEN Self-Hosted Compiler ==="

source = "x = 40 + 2" + chr(10) + "show x" + chr(10)

tok_types = []
tok_vals = []
tok_lines = []
lex_run(source)
ntoks = len(tok_types)
show "  [1] Lexed:"
show ntoks

p_types = tok_types
p_vals = tok_vals
p_lines = tok_lines
p_pos[0] = 0
p_len[0] = ntoks
pa_result = []
stmts = parse_all()
nstmts = len(stmts)
show "  [2] Parsed:"
show nstmts

errors = []
sym_globals = map_new()
ana_scope[0] = 0
ana_in_loop[0] = 0
ana_register_funcs(stmts)
ana_block(stmts)
nerrs = len(errors)
show "  [3] Errors:"
show nerrs

ir_code = []
ir_reg[0] = 0
ir_label[0] = 0
ir_block(stmts)
nir = len(ir_code)
show "  [4] IR:"
show nir

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir_code)
nasm_count = len(asm_lines)
show "  [5] Assembly:"
show nasm_count

output = ""
i = 0
nlines = len(asm_lines)
while i < nlines
    output = output + asm_lines[i] + chr(10)
    i = i + 1
end
write "build/selfhost_output.asm", output
show "  [6] Wrote build/selfhost_output.asm"
show "=== COMPILATION COMPLETE ==="
