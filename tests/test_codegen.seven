!! Test codegen: build IR by hand, run codegen, check output
!! Must include codegen inline (SEVEN has no imports)

!! ============================================================
!! Codegen module (inline copy)
!! ============================================================

asm_lines = []
asm_data  = []
asm_bss   = []
asm_str_count = [0]
cg_label = [0]
asm_var_names = []

func emit(line)
    push(asm_lines, line)
end

func emit_data(line)
    push(asm_data, line)
end

func emit_bss(line)
    push(asm_bss, line)
end

func cg_has_var(name)
    i = 0
    while i < len(asm_var_names)
        if asm_var_names[i] == name
            return 1
        end
        i = i + 1
    end
    return 0
end

func ensure_var(name)
    if cg_has_var(name) == 0
        push(asm_var_names, name)
        emit_bss("    _v_" + name + " resq 1")
    end
end

func add_string(s)
    idx = asm_str_count[0]
    asm_str_count[0] = asm_str_count[0] + 1
    label = "_s" + str(idx)
    slen = len(s)
    emit_data("    " + label + " db " + chr(34) + s + chr(34) + ", 0")
    emit_data("    " + label + "_len equ " + str(slen))
    return label
end

func emit_header()
    emit("; Generated by SEVEN Self-Hosted Compiler")
    emit("; x86-64 NASM (Linux ELF64)")
    emit("")
    emit("extern rt_init, rt_alloc, rt_exit")
    emit("extern rt_print_str, rt_print_int, rt_print_newline")
    emit("extern rt_print_val")
    emit("extern rt_str_to_int, rt_str_len, rt_str_concat")
    emit("extern rt_int_to_str, rt_str_eq, rt_str_copy")
    emit("extern rt_div_check")
    emit("extern rt_arr_new, rt_arr_push, rt_arr_get, rt_arr_set, rt_arr_len")
    emit("extern rt_len, rt_type")
    emit("extern rt_ord, rt_chr, rt_substr, rt_str_char_at")
    emit("extern rt_abs, rt_min, rt_max, rt_sqrt, rt_pow, rt_random")
    emit("extern rt_range, rt_assert")
    emit("extern rt_subscript")
    emit("extern rt_str_upper, rt_str_lower, rt_str_trim")
    emit("extern rt_str_contains, rt_str_replace")
    emit("extern rt_str_startswith, rt_str_endswith")
    emit("extern rt_str_index, rt_str_split")
    emit("extern rt_arr_slice, rt_arr_reverse, rt_arr_sort, rt_arr_join")
    emit("extern rt_file_read_str, rt_file_write_str")
    emit("extern rt_file_exists")
    emit("extern rt_time, rt_clock, rt_sleep")
    emit("extern rt_prompt, rt_read_line")
    emit("extern saved_rsp")
    emit("")
    emit("section .text")
    emit("    global _start")
    emit("")
    emit("_start:")
    emit("    mov [saved_rsp], rsp")
    emit("    call rt_init")
end

func emit_footer()
    emit("")
    emit("    ; exit(0)")
    emit("    mov rax, 60")
    emit("    xor rdi, rdi")
    emit("    syscall")
end

func codegen_inst(inst)
    op = map_get(inst, "op")
    if op == "CONST"
        val = map_get(inst, "value")
        vtype = type(val)
        if vtype == "string"
            slabel = add_string(val)
            emit("    mov rax, " + slabel)
            emit("    push rax")
        else
            emit("    mov rax, " + str(val))
            emit("    push rax")
        end
        return 0
    end
    if op == "LOAD"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    mov rax, [_v_" + name + "]")
        emit("    push rax")
        return 0
    end
    if op == "STORE"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    pop rax")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end
    if op == "BINOP"
        bop = map_get(inst, "binop")
        emit("    pop rbx")
        emit("    pop rax")
        if bop == "+"
            lnum = cg_label[0]
            cg_label[0] = cg_label[0] + 1
            emit("    cmp rax, 0x400000")
            emit("    jb _add_int_" + str(lnum))
            emit("    cmp rbx, 0x400000")
            emit("    jb _add_int_" + str(lnum))
            emit("    mov rdi, rax")
            emit("    mov rsi, rbx")
            emit("    call rt_str_concat")
            emit("    jmp _add_done_" + str(lnum))
            emit("_add_int_" + str(lnum) + ":")
            emit("    add rax, rbx")
            emit("_add_done_" + str(lnum) + ":")
        elif bop == "<"
            emit("    cmp rax, rbx")
            emit("    setl al")
            emit("    movzx rax, al")
        end
        emit("    push rax")
        return 0
    end
    if op == "SHOW"
        emit("    pop rdi")
        emit("    call rt_print_val")
        emit("    call rt_print_newline")
        return 0
    end
    if op == "LABEL"
        name = map_get(inst, "name")
        emit(name + ":")
        return 0
    end
    if op == "JMP"
        label = map_get(inst, "label")
        emit("    jmp " + label)
        return 0
    end
    if op == "JZ"
        label = map_get(inst, "label")
        emit("    pop rax")
        emit("    test rax, rax")
        emit("    jz " + label)
        return 0
    end
    if op == "FUNC"
        fname = map_get(inst, "name")
        emit("")
        emit("_f_" + fname + ":")
        emit("    push rbp")
        emit("    mov rbp, rsp")
        return 0
    end
    if op == "PARAM"
        name = map_get(inst, "name")
        ensure_var(name)
        emit("    pop rax")
        emit("    mov [_v_" + name + "], rax")
        return 0
    end
    if op == "ENDFUNC"
        emit("    xor rax, rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end
    if op == "RET"
        emit("    pop rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end
    if op == "RET0"
        emit("    xor rax, rax")
        emit("    mov rsp, rbp")
        emit("    pop rbp")
        emit("    ret")
        return 0
    end
    if op == "ARG"
        return 0
    end
    if op == "CALL"
        fname = map_get(inst, "name")
        nargs = map_get(inst, "nargs")
        if fname == "len"
            emit("    pop rdi")
            emit("    call rt_len")
            emit("    push rax")
        elif fname == "str"
            emit("    pop rdi")
            emit("    call rt_int_to_str")
            emit("    push rax")
        else
            emit("    call _f_" + fname)
            emit("    push rax")
        end
        return 0
    end
    if op == "ASSERT"
        emit("    pop rdi")
        emit("    call rt_assert")
        return 0
    end
    if op == "NOP"
        return 0
    end
    return 0
end

func codegen_generate(ir)
    emit_header()
    i = 0
    while i < len(ir)
        codegen_inst(ir[i])
        i = i + 1
    end
    emit_footer()
    emit("")
    emit("section .data")
    emit("    _nl db 10")
    j = 0
    while j < len(asm_data)
        push(asm_lines, asm_data[j])
        j = j + 1
    end
    emit("")
    emit("section .bss")
    emit("    __err resq 1")
    j = 0
    while j < len(asm_bss)
        push(asm_lines, asm_bss[j])
        j = j + 1
    end
end

!! ============================================================
!! Helpers: build IR instructions
!! ============================================================
func mk_ir(op)
    n = map_new()
    n = map_set(n, "op", op)
    return n
end

func ir_const_int(val)
    n = mk_ir("CONST")
    n = map_set(n, "value", val)
    return n
end

func ir_const_str(val)
    n = mk_ir("CONST")
    n = map_set(n, "value", val)
    return n
end

func ir_store(name)
    n = mk_ir("STORE")
    n = map_set(n, "name", name)
    return n
end

func ir_load(name)
    n = mk_ir("LOAD")
    n = map_set(n, "name", name)
    return n
end

func ir_binop(op)
    n = mk_ir("BINOP")
    n = map_set(n, "binop", op)
    return n
end

func ir_show()
    return mk_ir("SHOW")
end

func ir_label(name)
    n = mk_ir("LABEL")
    n = map_set(n, "name", name)
    return n
end

func ir_jmp(label)
    n = mk_ir("JMP")
    n = map_set(n, "label", label)
    return n
end

func ir_jz(label)
    n = mk_ir("JZ")
    n = map_set(n, "label", label)
    return n
end

func ir_func(name)
    n = mk_ir("FUNC")
    n = map_set(n, "name", name)
    return n
end

func ir_param(name)
    n = mk_ir("PARAM")
    n = map_set(n, "name", name)
    return n
end

func ir_endfunc()
    return mk_ir("ENDFUNC")
end

func ir_ret()
    return mk_ir("RET")
end

func ir_call(name, nargs)
    n = mk_ir("CALL")
    n = map_set(n, "name", name)
    n = map_set(n, "nargs", nargs)
    return n
end

func ir_arg()
    return mk_ir("ARG")
end

!! ============================================================
!! Check helper
!! ============================================================
pass_count = [0]
fail_count = [0]

func check(name, cond)
    if cond == 1
        show "PASS: {name}"
        pass_count[0] = pass_count[0] + 1
    else
        show "FAIL: {name}"
        fail_count[0] = fail_count[0] + 1
    end
end

func has_line(text)
    i = 0
    while i < len(asm_lines)
        if asm_lines[i] == text
            return 1
        end
        i = i + 1
    end
    return 0
end

!! ============================================================
!! TEST 1: x = 42; show x
!! IR: CONST 42, STORE x, LOAD x, SHOW
!! ============================================================
show "=== T1: assign + show ==="
ir = []
push(ir, ir_const_int(42))
push(ir, ir_store("x"))
push(ir, ir_load("x"))
push(ir, ir_show())

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir)

check("T1 has header", has_line("; Generated by SEVEN Self-Hosted Compiler"))
check("T1 has _start", has_line("_start:"))
check("T1 has mov 42", has_line("    mov rax, 42"))
check("T1 has store x", has_line("    mov [_v_x], rax"))
check("T1 has load x", has_line("    mov rax, [_v_x]"))
check("T1 has print", has_line("    call rt_print_val"))
check("T1 has bss x", has_line("    _v_x resq 1"))
check("T1 has exit", has_line("    mov rax, 60"))

nlines = len(asm_lines)
show "  total lines: {nlines}"

!! ============================================================
!! TEST 2: show "Hello"
!! IR: CONST "Hello", SHOW
!! ============================================================
show "=== T2: string const ==="
ir = []
push(ir, ir_const_str("Hello"))
push(ir, ir_show())

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir)

check("T2 has mov str", has_line("    mov rax, _s0"))
dq = chr(34)
check("T2 has data", has_line("    _s0 db " + dq + "Hello" + dq + ", 0"))
check("T2 has len", has_line("    _s0_len equ 5"))

!! ============================================================
!! TEST 3: while loop
!! i = 0; while i < 10: show i; i = i + 1
!! IR: CONST 0, STORE i, LABEL L0, LOAD i, CONST 10, BINOP <,
!!     JZ L1, LOAD i, SHOW, LOAD i, CONST 1, BINOP +, STORE i,
!!     JMP L0, LABEL L1
!! ============================================================
show "=== T3: while loop ==="
ir = []
push(ir, ir_const_int(0))
push(ir, ir_store("i"))
push(ir, ir_label("L0"))
push(ir, ir_load("i"))
push(ir, ir_const_int(10))
push(ir, ir_binop("<"))
push(ir, ir_jz("L1"))
push(ir, ir_load("i"))
push(ir, ir_show())
push(ir, ir_load("i"))
push(ir, ir_const_int(1))
push(ir, ir_binop("+"))
push(ir, ir_store("i"))
push(ir, ir_jmp("L0"))
push(ir, ir_label("L1"))

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir)

check("T3 has L0 label", has_line("L0:"))
check("T3 has L1 label", has_line("L1:"))
check("T3 has jz L1", has_line("    jz L1"))
check("T3 has jmp L0", has_line("    jmp L0"))
check("T3 has setl", has_line("    setl al"))

!! ============================================================
!! TEST 4: func double(n) return n * 2 end
!! IR: FUNC double, PARAM n, LOAD n, CONST 2, BINOP *, RET, ENDFUNC
!! ============================================================
show "=== T4: function def ==="
ir = []
push(ir, ir_func("double"))
push(ir, ir_param("n"))
push(ir, ir_load("n"))
push(ir, ir_const_int(2))
push(ir, ir_binop("+"))
push(ir, ir_ret())
push(ir, ir_endfunc())

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir)

check("T4 has func label", has_line("_f_double:"))
check("T4 has push rbp", has_line("    push rbp"))
check("T4 has mov rbp rsp", has_line("    mov rbp, rsp"))
check("T4 has param store", has_line("    mov [_v_n], rax"))
check("T4 has ret", has_line("    ret"))

!! ============================================================
!! TEST 5: function call — len("abc")
!! IR: CONST "abc", ARG, CALL len 1
!! ============================================================
show "=== T5: builtin call ==="
ir = []
push(ir, ir_const_str("abc"))
push(ir, ir_arg())
push(ir, ir_call("len", 1))
push(ir, ir_show())

asm_lines = []
asm_data = []
asm_bss = []
asm_var_names = []
asm_str_count[0] = 0
cg_label[0] = 0
codegen_generate(ir)

check("T5 has call rt_len", has_line("    call rt_len"))
check("T5 has push result", has_line("    push rax"))

!! ============================================================
!! Summary
!! ============================================================
show ""
p = pass_count[0]
f = fail_count[0]
show "Results: {p} passed, {f} failed"
show "all_done"
